# Required. `build`, `extract` and `init-assumptions` refuse to run without a credential.
ANTHROPIC_API_KEY=sk-ant-...

# --- Model -------------------------------------------------------------------
# Extraction is the fabrication-sensitive stage, so it defaults to the most
# accurate model rather than the cheapest. Override per-run with --model.
# PDCFO_MODEL=claude-opus-5
# PDCFO_EFFORT=high              # low | medium | high | xhigh | max
# PDCFO_MAX_TOKENS=16000

# --- Modelling ---------------------------------------------------------------
# PDCFO_YEARS=5                  # forecast horizon, minimum 3
# PDCFO_LOADED_COST_MULTIPLIER=1.28   # payroll tax, benefits, equipment, seats

# --- Provenance --------------------------------------------------------------
# Fraction of CORE_INPUTS that must be sourced from the deck itself before
# --strict will let a run complete. Below this the model is mostly benchmark.
# PDCFO_STRICT_COVERAGE_THRESHOLD=0.40

# --- Caching -----------------------------------------------------------------
# Extraction responses are cached by (file sha256 + prompt version + model), so
# iterating on rendering costs nothing in API calls. Bypass with --no-cache.
# PDCFO_CACHE_DIR=~/.cache/pitchdeck-cfo

# --- Web app (app.py) --------------------------------------------------------
# Set APP_PASSWORD to put the whole app behind HTTP Basic. LEFT UNSET, THE APP IS
# OPEN: anyone with the URL can upload a deck and spend the key above. The upload
# page states which of the two it is, so the deployment cannot lie about itself.
# APP_PASSWORD=
# APP_USERNAME=ten

# MAX_UPLOAD_MB=40          # reject larger uploads
# JOB_TTL_MINUTES=120       # uploaded decks and artifacts are deleted after this
# MAX_CONCURRENT_JOBS=2     # each build spends real money; unbounded is a bad idea

# --- Email delivery (Resend) -------------------------------------------------
# Set RESEND_API_KEY and every completed build is emailed to EMAIL_TO with both
# documents attached. Leave it unset and nothing is sent -- and the upload page
# says so, because it reads this same configuration rather than a hand-written
# promise. EMAIL_FROM must be on a domain verified in your Resend account.
# RESEND_API_KEY=re_...
# EMAIL_TO=Info@tencapital.group
# EMAIL_FROM=pitchdeck-cfo@tencapital.group
