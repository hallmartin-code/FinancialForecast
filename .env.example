# Required. `build`, `extract` and `init-assumptions` refuse to run without a credential.
ANTHROPIC_API_KEY=sk-ant-...

# --- Model -------------------------------------------------------------------
# Extraction is the fabrication-sensitive stage, so it defaults to the most
# accurate model rather than the cheapest. Override per-run with --model.
# PDCFO_MODEL=claude-opus-5
# PDCFO_EFFORT=high              # low | medium | high | xhigh | max
# PDCFO_MAX_TOKENS=16000

# --- Modelling ---------------------------------------------------------------
# PDCFO_YEARS=5                  # forecast horizon, minimum 3
# PDCFO_LOADED_COST_MULTIPLIER=1.28   # payroll tax, benefits, equipment, seats

# --- Provenance --------------------------------------------------------------
# Fraction of CORE_INPUTS that must be sourced from the deck itself before
# --strict will let a run complete. Below this the model is mostly benchmark.
# PDCFO_STRICT_COVERAGE_THRESHOLD=0.40

# --- Caching -----------------------------------------------------------------
# Extraction responses are cached by (file sha256 + prompt version + model), so
# iterating on rendering costs nothing in API calls. Bypass with --no-cache.
# PDCFO_CACHE_DIR=~/.cache/pitchdeck-cfo
